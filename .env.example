# Copy this file to .env and adjust as needed.

# --- Ollama (local LLM) ---
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=300

# --- Target repository the agent edits ---
# Absolute path to the git repo the agent should operate on.
# Leave unset to use the directory the server is launched from.
# TARGET_REPO_PATH=C:\Users\you\path\to\repo

# "owner/name" — used only to build GitHub links in the UI.
GITHUB_REPO=codewithabhay10/not-cursor-main

# Safety switch: when false, the agent commits locally but never pushes.
AUTO_PUSH=false

# --- Agent tuning ---
N_COMMITS_CONTEXT=5
GRAPH_RECURSION_LIMIT=100
